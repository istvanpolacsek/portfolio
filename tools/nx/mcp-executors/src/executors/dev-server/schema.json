{
  "$schema": "http://json-schema.org/schema",
  "title": "Dev Server Executor",
  "description": "Runs MCP server in development mode with hot-reload",
  "type": "object",
  "properties": {
    "main": {
      "type": "string",
      "description": "Entry point file",
      "default": "src/main.ts"
    },
    "watch": {
      "type": "boolean",
      "description": "Enable file watching and hot-reload",
      "default": true
    },
    "port": {
      "type": "number",
      "description": "Port to run the server on (if applicable)",
      "default": 3000
    },
    "envFile": {
      "type": "string",
      "description": "Environment file to load",
      "default": ".env.local"
    },
    "inspect": {
      "type": "boolean",
      "description": "Enable Node debugging",
      "default": false
    }
  },
  "required": ["main"]
}
